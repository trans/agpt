/tools/kenlm/
/tools/kenlm_venv/
*.dwarf
*.log
results.tsv
.env
/.mcp.json
.claude/
.codex
tags
data/comparison/
**/.playwright-cli/
data/gutenberg/*.txt
data/gutenberg_5m.txt
rnd/convergence/**/*.csv
data/input.agpt.model
data/input.random.model
data/synth_wrap_*.txt
data/wormhole_*.txt
data/gutenberg_5m_pgrouped.txt
rnd/wrap-around/*.model
rnd/seq-len-decouple/*.bin
rnd/streaming-agpt-v1/models/
rnd/per-rc-adam-v1/models/
rnd/per-rc-adam-v1/models_no_mw/
