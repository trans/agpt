rnd/legacy-rebaseline/**/*.model

# logs/ directories anywhere in the repo (experiment logs accumulate fast
# and most are intermediate-stage noise). Specific result logs that matter
# can still be added with `git add -f` if needed; already-tracked logs
# stay tracked.
logs/

# Smoke-test runs/state (transient verification of bin/agpt_experiment).
# Keep already-tracked configs available; ignore generated run dirs and
# indexes unless force-added for a specific reason.
rnd/_smoke/[0-9]*/
rnd/_smoke/README.md
rnd/_smoke/runs.json

# Orchestrator-generated experiment dirs (rnd/<exp>/<run-id>/): keep
# config/resolved_config + meta + result.json/eval_raw.json; ignore raw logs
# and large regenerable artifacts. Specific older experiment dirs have their
# own patterns above.
rnd/**/checkpoint.model
rnd/**/hf_checkpoint/
rnd/**/eval.log
# Carved corpus slices (regenerable from corpus.path + train_frac;
# the split offset is recorded in result.json + meta.json).
rnd/**/train_corpus.txt
rnd/**/heldout_corpus.txt

# Python bytecode anywhere in the tree (regenerated on import).
__pycache__/
*.pyc

# Hugging Face datasets cache that lm-eval leaks into run dirs.
# Cached arrow files; regenerable from corpus + lm-eval invocation.
rnd/**/.hf/

# Content-hashed caches produced by bin/agpt_carve and bin/agpt_build_radix_corpus.
# Regenerable from corpus.path + carve params / trie params; hashes are recorded
# in meta.json + manifest.json inside each cache dir.
data/.splits/
data/.tries/

# Ad hoc radix cache dumps under rnd/; regenerable binary materialization.
rnd/radix-depth*/**/*.bin
